# Required: Fish Audio (JARVIS's voice)
FISH_API_KEY=your-fish-audio-api-key-here

# JARVIS's brain is a Claude Code process running on YOUR Claude subscription.
# Install Claude Code (2.1.224+) and log in with `claude` — no Anthropic API
# key is needed for anything, and any ANTHROPIC_* variable set here is
# deliberately hidden from the brain so it can only use your login.

# Optional: which model the brain runs (default sonnet; always passed explicitly)
# JARVIS_BRAIN_MODEL=sonnet

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # or "celsius"

# Optional: free, local voice (no API costs). Needs the two optional packages:
#   pip install faster-whisper piper-tts
#   python -m piper.download_voices es_MX-claude-high   # or es_ES-davefx-medium
# JARVIS_STT=local records each utterance in the browser and transcribes it on
# this machine with faster-whisper, biased towards the expected vocabulary in
# stt.py. PIPER_VOICE (path to the .onnx) makes Piper speak instead of Fish.
# JARVIS_STT=local
# JARVIS_WHISPER_MODEL=small   # tiny/base are faster, medium/large-v3 more accurate
# PIPER_VOICE=/path/to/es_MX-claude-high.onnx

# Optional: cloud alternatives. JARVIS_STT=openai (the default when this key is
# set) transcribes with OpenAI instead of locally.
# OPENAI_API_KEY=
# JARVIS_STT_MODEL=gpt-4o-transcribe
# ElevenLabs instead of Fish (both must be set; PIPER_VOICE wins over it).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
